{
  "expo": {
    "name": "BANT",
    "slug": "bant",
    "scheme": "bant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/bant-app-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/brand/bant-mascot.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow BANT to use your microphone for live room conversations.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/bant-app-icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/bant-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
